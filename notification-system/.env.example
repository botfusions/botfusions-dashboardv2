# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Webhook URL (Telegram tarafından çağrılacak)
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/telegram/webhook

# Admin User ID'leri (Virgülle ayırın)
ADMIN_USER_IDS=123456789,987654321

# Dashboard API Configuration
DASHBOARD_API_URL=https://your-dashboard-api.com
DASHBOARD_API_TOKEN=your-dashboard-api-token

# Application Configuration
NODE_ENV=development
PORT=3000
WEBHOOK_URL=https://your-domain.com/api/telegram/webhook

# N8N Configuration (Opsiyonel)
N8N_HOST=http://localhost:5678
N8N_API_KEY=your-n8n-api-key
N8N_WORKFLOW_ID=your-workflow-id

# Admin Chat ID (Bildirim gönderilecek)
ADMIN_CHAT_ID=123456789

# Security Settings
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Database Configuration (Opsiyonel - gelecekte kullanım için)
DATABASE_URL=postgresql://user:password@localhost:5432/botfusions
REDIS_URL=redis://localhost:6379

# Logging Configuration
LOG_LEVEL=info
DEBUG_TELEGRAM=false

# Notification Settings
NOTIFICATION_COOLDOWN_SECONDS=300
MAX_NOTIFICATIONS_PER_MINUTE=10
DEFAULT_NOTIFICATION_ENABLED=true

# Feature Flags
ENABLE_ADMIN_NOTIFICATIONS=true
ENABLE_USER_SUBSCRIPTION=true
ENABLE_SYSTEM_MONITORING=true
ENABLE_PERFORMANCE_ALERTS=true
ENABLE_DAILY_SUMMARY=true