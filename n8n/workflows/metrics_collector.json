      "id": "cron-trigger",
      "name": "Hourly Cron",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "hourly-metrics-cron"
    },
    {
      "parameters": {
        "jsCode": "// Saati ve tarihi al\nconst now = new Date();\nconst currentHour = now.getHours();\nconst currentDate = now.toISOString().split('T')[0];\nconst tenantId = '00000000-0000-0000-0000-000000000000'; // Default tenant ID\n\n// Haftalık/aylık kontrolü\nconst dayOfWeek = now.getDay(); // 0 = Pazar, 1 = Pazartesi, vb.\nconst dayOfMonth = now.getDate();\nconst isWeekly = dayOfWeek === 1; // Her Pazartesi\nconst isMonthly = dayOfMonth === 1; // Her Ayın 1'i\n\n// Metrik verilerini oluştur\nconst metrics = [\n  {\n    tenant_id: tenantId,\n    metric_type: 'website_traffic',\n    metric_value: Math.floor(Math.random() * 500) + 100, // 100-600 arası rastgele\n    period_type: 'daily',\n    period_start: currentDate,\n    period_end: currentDate,\n    metadata: {\n      timestamp: now.toISOString(),\n      page_views: Math.floor(Math.random() * 1000) + 500,\n      unique_visitors: Math.floor(Math.random() * 300) + 150,\n      bounce_rate: (Math.random() * 0.4 + 0.2).toFixed(2)\n    }\n  },\n  {\n    tenant_id: tenantId,\n    metric_type: 'chatbot_usage',\n    metric_value: Math.floor(Math.random() * 50) + 10, // 10-60 arası\n    period_type: 'daily',\n    period_start: currentDate,\n    period_end: currentDate,\n    metadata: {\n      timestamp: now.toISOString(),\n      total_conversations: Math.floor(Math.random() * 100) + 20,\n      active_sessions: Math.floor(Math.random() * 25) + 5,\n      avg_session_duration: Math.floor(Math.random() * 300) + 60,\n      satisfaction_score: (Math.random() * 2 + 3).toFixed(1) // 3.0-5.0 arası\n    }\n  },\n  {\n    tenant_id: tenantId,\n    metric_type: 'keyword_performance',\n    metric_value: Math.floor(Math.random() * 100) + 50, // 50-150 arası\n    period_type: 'daily',\n    period_start: currentDate,\n    period_end: currentDate,\n    metadata: {\n      timestamp: now.toISOString(),\n      top_keywords: [\n        { keyword: 'chatbot', clicks: Math.floor(Math.random() * 100) },\n        { keyword: 'automation', clicks: Math.floor(Math.random() * 80) },\n        { keyword: 'ai', clicks: Math.floor(Math.random() * 120) }\n      ],\n      total_impressions: Math.floor(Math.random() * 5000) + 1000,\n      total_clicks: Math.floor(Math.random() * 500) + 100,\n      ctr: (Math.random() * 0.1 + 0.05).toFixed(3)\n    }\n  }\n];\n\n// Haftalık metrikler ekle\nif (isWeekly) {\n  metrics.push(\n    {\n      tenant_id: tenantId,\n      metric_type: 'weekly_summary',\n      metric_value: Math.floor(Math.random() * 10000) + 5000,\n      period_type: 'weekly',\n      period_start: currentDate,\n      period_end: currentDate,\n      metadata: {\n        timestamp: now.toISOString(),\n        total_weekly_traffic: Math.floor(Math.random() * 5000) + 2000,\n        total_conversations: Math.floor(Math.random() * 1000) + 500,\n        avg_response_time: (Math.random() * 2 + 1).toFixed(2),\n        user_satisfaction: (Math.random() * 1 + 4).toFixed(1)\n      }\n    }\n  );\n}\n\n// Aylık metrikler ekle\nif (isMonthly) {\n  metrics.push(\n    {\n      tenant_id: tenantId,\n      metric_type: 'monthly_summary',\n      metric_value: Math.floor(Math.random() * 50000) + 20000,\n      period_type: 'monthly',\n      period_start: currentDate,\n      period_end: currentDate,\n      metadata: {\n        timestamp: now.toISOString(),\n        monthly_revenue: Math.floor(Math.random() * 10000) + 5000,\n        customer_acquisition: Math.floor(Math.random() * 200) + 100,\n        churn_rate: (Math.random() * 0.1 + 0.05).toFixed(3),\n        growth_rate: (Math.random() * 0.3 + 0.1).toFixed(2)\n      }\n    }\n  );\n}\n\nreturn [{ json: { metrics, timestamp: now.toISOString() } }];"
      },
